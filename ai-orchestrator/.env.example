# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Shared bearer token used BOTH ways: Rails -> Python (POST /process) and
# Python -> Rails (POST /api/internal/ai_execute_tool). Must match Rails' INTERNAL_AI_TOKEN.
RAILS_INTERNAL_API_TOKEN=

# Base URL of the Rails app, no trailing slash (e.g. http://rails:3000 in Docker, http://localhost:3000 locally)
RAILS_BASE_URL=http://localhost:3000

# How many function-calling round-trips to allow in a single turn before cutting off
MAX_TOOL_ITERATIONS=8

# Timeout (seconds) for the webhook call back into Rails when executing a custom tool
RAILS_TOOL_TIMEOUT=30

# Teto por chamada à OpenAI (segundos) e retries automáticos do SDK. O default do SDK seria 600s/2.
OPENAI_TIMEOUT=45
OPENAI_MAX_RETRIES=1

# Orçamento de parede do turno inteiro (segundos): passado disto o orquestrador para de abrir rodada
# nova de ferramenta e fecha a resposta. Mantenha SEMPRE menor que o AI_ORCHESTRATOR_TIMEOUT do Rails.
TURN_BUDGET_SECONDS=90
