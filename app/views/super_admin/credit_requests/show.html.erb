<%# Show da fila de solicitações de créditos (super_admin). resource_class real é AiCreditRequest,
    mas rotas/controller usam "credit_request" — a renderização AUTOMÁTICA de atributos do
    Administrate (render_field/page.attributes) depende de resolução de rota que quebra nesse
    mesmo mismatch (mesma causa do 500 já corrigido no index). Em vez de descobrir CADA campo que
    quebra um por um, a tela inteira é explícita: sem nenhuma dependência da maquinaria automática
    do Administrate. %>

<% content_for(:title) { "Solicitação ##{page.resource.id}" } %>

<header class="main-content__header">
  <h1 class="main-content__page-title"><%= content_for(:title) %></h1>
</header>

<section class="main-content__body">
  <dl>
    <dt class="attribute-label">ID</dt>
    <dd class="attribute-data"><%= page.resource.id %></dd>

    <dt class="attribute-label">Conta</dt>
    <dd class="attribute-data">
      <%= link_to "##{page.resource.account_id} — #{page.resource.account.name}", super_admin_account_path(page.resource.account) %>
    </dd>

    <dt class="attribute-label">Solicitado por</dt>
    <dd class="attribute-data"><%= page.resource.requested_by&.name %> (<%= page.resource.requested_by&.email %>)</dd>

    <dt class="attribute-label">Créditos solicitados</dt>
    <dd class="attribute-data"><%= page.resource.amount_requested %></dd>

    <dt class="attribute-label">Motivo</dt>
    <dd class="attribute-data"><%= page.resource.reason.presence || "—" %></dd>

    <dt class="attribute-label">Status</dt>
    <dd class="attribute-data"><%= { 'pending' => 'Pendente', 'approved' => 'Aprovada', 'rejected' => 'Rejeitada' }[page.resource.status] %></dd>

    <dt class="attribute-label">Revisado por</dt>
    <dd class="attribute-data"><%= page.resource.approved_by&.name || "—" %></dd>

    <dt class="attribute-label">Nota da revisão</dt>
    <dd class="attribute-data"><%= page.resource.review_note.presence || "—" %></dd>

    <dt class="attribute-label">Revisado em</dt>
    <dd class="attribute-data"><%= page.resource.reviewed_at&.strftime('%d/%m/%Y %H:%M') || "—" %></dd>

    <dt class="attribute-label">Criado em</dt>
    <dd class="attribute-data"><%= page.resource.created_at&.strftime('%d/%m/%Y %H:%M') %></dd>
  </dl>
</section>

<% if page.resource.pending? %>
  <% plan = page.resource.account.subscriptions.current.first&.plan %>
  <% unit_price_cents = plan&.ai_credit_overage_price_cents %>
  <section class="main-content__body">
    <hr/>
    <h3>Ações</h3>

    <div class="pb-3">
      <p>Aprovar adiciona <strong><%= page.resource.amount_requested %></strong> créditos avulsos (permanentes) à conta <strong>#<%= page.resource.account_id %></strong>, gera uma cobrança de excedente (pendente de fatura) e marca a solicitação como aprovada.</p>
      <% if unit_price_cents.present? %>
        <p>Preço configurado no plano: <strong>R$ <%= MoneyCents.format(unit_price_cents) %></strong> por crédito — total a cobrar: <strong>R$ <%= MoneyCents.format(unit_price_cents * page.resource.amount_requested) %></strong>.</p>
      <% elsif plan.present? %>
        <p class="text-danger">
          <strong>O plano <%= plan.name %> não tem preço de crédito excedente configurado.</strong>
          Aprovar vai falhar até isso ser definido.
          <%= link_to "Definir preço agora", edit_super_admin_plan_path(plan) %>.
        </p>
      <% else %>
        <p class="text-danger"><strong>Esta conta não tem plano/assinatura ativa.</strong> Aprovar vai falhar até a conta ter um plano.</p>
      <% end %>
    </div>

    <%= form_with url: approve_super_admin_credit_request_path(page.resource), method: :post, class: "form" do %>
      <div class="form-actions">
        <%= submit_tag "Aprovar e creditar", disabled: unit_price_cents.blank? %>
      </div>
    <% end %>

    <hr/>

    <%= form_with url: reject_super_admin_credit_request_path(page.resource), method: :post, class: "form" do %>
      <div class="pb-3">
        <label>Motivo da rejeição (opcional)</label><br/>
        <%= text_area_tag :review_note, nil, rows: 2 %>
      </div>
      <div class="form-actions">
        <%= submit_tag "Rejeitar", class: "button button--danger" %>
      </div>
    <% end %>
  </section>
<% end %>
