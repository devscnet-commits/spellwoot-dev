<div class="field-unit__label">
  <label>Limites do plano</label>
</div>
<div class="field-unit__field">
  <div class="grid grid-cols-1 gap-4">
    <% field.data.each do |key, info| %>
      <div class="p-3 bg-white rounded-lg shadow-sm outline outline-1 outline-n-container">
        <div class="text-sm font-medium text-slate-700 mb-2"><%= info[:label] %></div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
          <label class="text-xs text-slate-500">
            Máximo (em branco = ilimitado)
            <%= number_field_tag "plan_limits[#{key}][max_value]", info[:max_value],
                                 min: 0, class: 'w-full mt-1 rounded border-slate-300' %>
          </label>
          <label class="text-xs text-slate-500">
            Ao exceder
            <%= select_tag "plan_limits[#{key}][overflow_behavior]",
                           options_for_select(Plan::OVERFLOW_BEHAVIOR_LABELS.invert, info[:overflow_behavior]),
                           class: 'w-full mt-1 rounded border-slate-300' %>
          </label>
          <label class="text-xs text-slate-500">
            Preço por unidade excedente, por mês (R$)
            <%= text_field_tag "plan_limits[#{key}][overage_price_cents]", MoneyCents.format(info[:overage_price_cents]),
                               placeholder: '0,00', inputmode: 'decimal', class: 'w-full mt-1 rounded border-slate-300' %>
          </label>
        </div>
      </div>
    <% end %>
  </div>

  <p class="text-xs text-slate-500 mt-3">
    Em branco = ilimitado. <strong>0 significa zero permitido</strong>, não ilimitado — é assim que um
    plano bloqueia um recurso por completo. "Ao exceder" e o preço só valem quando há um máximo.
  </p>
</div>
